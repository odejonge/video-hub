generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String?
  avatar       String?
  provider     String
  providerId   String
  credits      Int           @default(10)
  collections  Collection[]
  ownedVideos  Video[]       @relation("VideoOwner")
  videoAccess  VideoAccess[]
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([provider, providerId])
}

model Collection {
  id          String   @id @default(cuid())
  name        String
  description String?
  isPublic    Boolean  @default(false)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clips       Clip[]
  tags        Tag[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Source video - owned by user, can be shared with other users
model Video {
  id           String        @id @default(cuid())
  title        String
  videoUrl     String
  thumbnailUrl String?
  duration     Float?
  bunnyVideoId String?
  ownerId      String
  owner        User          @relation("VideoOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  sharedWith   VideoAccess[]
  clips        Clip[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// Many-to-many: Video shared with Users
model VideoAccess {
  videoId   String
  userId    String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([videoId, userId])
}

// Clip - a segment of a video with start/end times
model Clip {
  id           String    @id @default(cuid())
  title        String
  startTime    Float     @default(0)
  endTime      Float?
  videoId      String
  video        Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  tags         ClipTag[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Tag - belongs to a collection, unique name within collection
model Tag {
  id           String     @id @default(cuid())
  name         String
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  clips        ClipTag[]

  @@unique([collectionId, name])
}

model ClipTag {
  clipId String
  tagId  String
  clip   Clip   @relation(fields: [clipId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([clipId, tagId])
}

// Template - predefined tag sets for different disciplines
model Template {
  id          String        @id @default(cuid())
  name        String        @unique
  description String?
  tags        TemplateTag[]
  createdAt   DateTime      @default(now())
}

// Tags within a template
model TemplateTag {
  id         String   @id @default(cuid())
  name       String
  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int
  type        String
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())
}

model CreditPackage {
  id       String  @id @default(cuid())
  name     String
  credits  Int
  priceEur Int
  active   Boolean @default(true)
}
